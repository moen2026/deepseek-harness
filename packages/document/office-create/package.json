{
  "name": "@deepseek-ai/dsh-office-create",
  "description": "LibreOffice-kit document-creation provider for ctx.documents — translates neutral content blocks into OpenDocument intermediates and exports DOCX/XLSX/PPTX through the kit converter (native engine with Node WASM fallback)",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/document/office-create"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-documents": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/libreoffice-kit": "^0.1.1",
    "@deepseek-ai/schemastery": "workspace:~",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-documents": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*"
  }
}
