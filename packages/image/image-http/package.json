{
  "name": "@deepseek-ai/dsh-image-http",
  "description": "OpenAI-compatible HTTP image-generation provider for the DeepSeek Harness image seam (ctx.image) — posts text prompts as JSON to a deployment-configured /images/generations endpoint requesting base64 answers, reads the bearer token from a named environment variable at call time, and surfaces endpoint failures as typed IMAGE_PROVIDER_FAILED errors with no local fallback",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/image/image-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-image": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-image": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  }
}
